[13.87421, "o", "==================================================\r\n Network Diagnostic Toolkit v1.0.0\r\n==================================================\r\n\r\nUsage:\r\n  network-tool <module> <command>\r\n\r\nModules:\r\n  interfaces\r\n  dns\r\n  ping\r\n  ports\r\n  routing\r\n  traceroute\r\n  http\r\n  ssl\r\n  firewall\r\n  connections\r\n  reports\r\n\r\nGlobal Commands:\r\n  help, --help, -h\r\n  version, --version, -v\r\n\r\nExamples:\r\n  network-tool interfaces list\r\n  network-tool dns lookup google.com\r\n  network-tool ping run google.com\r\n  network-tool ports scan google.com\r\n  network-tool routing table\r\n  network-tool http health https://google.com\r\n  network-tool ssl info google.com\r\n  network-tool firewall status\r\n  network-tool connections active\r\n  network-tool reports summary\r\n\r\n"]
